      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "resume_text",
              "name": "resume_text",
              "type": "string",
              "value": "={{ ($json.text && $json.text.trim().length > 0) ? $json.text : ($('Job Application Form').item.json['Resume Text'] || '') }}"
            },
            {
              "id": "job_description",
              "name": "job_description",
              "type": "string",
              "value": "={{ $('Job Application Form').item.json['Job Description'] }}"
            }
