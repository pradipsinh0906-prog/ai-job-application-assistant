    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.resume_text }}\nJob Description:\n{{ $json.job_description }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=CRITICAL SCORING RULE: If more than 50% of the JD's Required Skills are completely absent\nfrom the resume (not just \"less experienced in\", but entirely absent), the match_score MUST\nNOT exceed 35, regardless of how strong the candidate's other skills are."
            }
          ]
        },
        "batching": {}
      },
      "id": "a2728c6d-f2a9-4b8f-a41c-e82ed85ec1d9",
