      "typeVersion": 1.9,
      "position": [
        672,
        112
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"match_score\": 82,\n  \"recommendation\": \"Strong Match\",\n  \"fit_summary\": \"Concise 2-3 sentence summary of how well the candidate fits the role.\",\n  \"key_strengths\": [\n    \"Relevant strength aligned to the job description\",\n    \"Another matching qualification or achievement\"\n  ],\n  \"gaps\": [\n    \"A requirement from the JD the resume does not clearly address\"\n  ],\n  \"missing_ats_keywords\": [\n    \"keyword one\",\n    \"keyword two\",\n    \"keyword three\"\n  ],\n  \"cover_letter\": \"A tailored cover letter of 150-200 words addressed to the hiring team.\"\n}"
      },
